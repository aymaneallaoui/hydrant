# Socket address to bind.
HYDRANT_LISTEN_ADDR=127.0.0.1:8080
# tracing EnvFilter directive, e.g. info,tower_http=debug.
HYDRANT_LOG_LEVEL=info
# Log output format: pretty or json.
HYDRANT_LOG_FORMAT=pretty
# Seconds to wait for in-flight connections after a shutdown signal.
HYDRANT_SHUTDOWN_TIMEOUT_SECS=10
# Per-topic broadcast ring size (>= 1), rounded up to a power of two (300 retains 512). Worst-case memory per topic is the retained count times HYDRANT_MAX_MESSAGE_BYTES.
HYDRANT_TOPIC_CAPACITY=256
# What to do with a subscriber that lags past the ring: disconnect or drop.
HYDRANT_SLOW_CONSUMER_POLICY=disconnect
# Seconds a WebSocket or SSE send may block before the peer is treated as a slow consumer (>= 1).
HYDRANT_SEND_TIMEOUT_SECS=10
# Seconds between SSE keep-alive comments (>= 1).
HYDRANT_SSE_KEEPALIVE_SECS=15
# Maximum accepted publish body, in bytes.
HYDRANT_MAX_MESSAGE_BYTES=65536
# Optional cap on SSE plus WebSocket connections (>= 1); new subscribers get 503 at the cap. Unset means unlimited.
# HYDRANT_MAX_CONNECTIONS=10000
